.env
web/.env
.DS_Store
**/.DS_Store
__pycache__/
web/node_modules
web/dist
# generated data — only data/pf_team_defense_2025.json is tracked
data/*.parquet
data/*.db
data/*.pkl
data/board_*.json
data/board_*.csv
data/teams_*.json
# ...but ship the public boards: they are what the deployed API serves (nflverse-derived, no PropFinder fields)
!data/board_w*_public.json
!data/teams_w*.json
!data/scorecard_w*.json
data/upcoming_*.parquet
data/pf_status_*.json
# licensed odds — display only, never redistribute.
# (gitignore has no trailing comments: a '#' only starts a comment at column 1,
#  so keeping this note on the pattern line silently disabled the rule.)
data/oddsapi_raw*.json
data/props*.json
dist-test
