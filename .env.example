# copy to .env — never commit .env
DATABASE_URL=sqlite:///data/sixpts.db        # Supabase: postgresql+psycopg://user:pass@host:5432/postgres
SIXPTS_TOKEN=change-me                        # header X-Token for private routes
SIXPTS_DATA=data
# PropFinder session (private only). Copy from a logged-in browser request's headers. Leave blank to run nflverse-only.
PF_COOKIE=
PF_BEARER=
CORS_ORIGINS=http://localhost:5173,https://sixpts.com

# --- optional user accounts (Supabase Auth). Leave blank to run single-user with SIXPTS_TOKEN.
SUPABASE_JWT_SECRET=          # Supabase -> Settings -> API -> JWT secret
ADMIN_USER_ID=                # your Supabase user id (house record)
# web/.env: VITE_SUPABASE_URL=..., VITE_SUPABASE_ANON_KEY=...

# --- licensed odds (the-odds-api.com — free tier is 500 credits/month, ~16 per slate refresh)
ODDS_API_KEY=

# --- live touchdown notifications (engine/live_td.py). All optional.
NTFY_TOPIC=              # pick any unguessable name, install the ntfy app, subscribe to it
TELEGRAM_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
